# Netbox parameters
NB_URL=http://<ip>:8000
NB_TOKEN=

# Device connection parameters
DEV_USERNAME=
DEV_PASSWORD=
DEV_KEYFILE=

# Some Ubiquiti devices only support a single admin account, so a dedicated
# DEV_USERNAME account can't be created on them. Tried before falling back
# to DEV_USERNAME/DEV_PASSWORD.
DEV_UBNT_USERNAME=
DEV_UBNT_PASSWORD=

# Tachyon Networks devices (drivers/tachyon.py) use their own dedicated
# credential rather than DEV_USERNAME/DEV_PASSWORD - no fallback, so both
# of these must be set for Tachyon devices to sync at all. VLANs (and, on
# a radio, the live wireless PSK) are only readable by an admin-level
# account - see QUIRKS.md.
DEV_TACH_USERNAME=
DEV_TACH_PASSWORD=

# Automatic cabling assumptions, both off by default - see the "Automatic
# device linking" section of README.md.
#
# /30 and /31 subnets only ever have 2 usable host addresses, so two
# interfaces (on different devices) whose IPs land in the same one of
# these can safely be assumed to be the two ends of one cable. Blind
# subnet matching with no other corroborating evidence, so opt-in.
ASSUME_SUBNET_LINKS_30_31=False
# For backhaul PtP wireless pairs specifically (an existing WirelessLink):
# assumes each side's own wired uplink port is cabled to the router port
# sharing their site's half of the pair's /29 block. Much better-evidenced
# than the /30/31 rule (built on an already-confirmed live wireless link),
# but still an assumption, so it has its own separate gate.
ASSUME_SUBNET_LINKS_29=False

# Auto-provision a placeholder client Device (+ one wireless Interface,
# MAC, and IPs) for a point-to-multipoint peer that isn't already tracked
# in NetBox at all - e.g. a customer's CPE this fleet only ever sees over
# the air. Only applies to platforms with an entry in sync.py's
# _CLIENT_DEVICE_CONVENTIONS - currently Tachyon ("TACH-<peer's reported
# name>") and all three Ubiquiti-family platforms, AirOS v8/AirFiber/UISP
# ("UBNT-<peer's reported name>" - deliberately distinct from this
# fleet's pre-existing manual "CUST-<name>" customer-CPE convention, so
# an auto-created placeholder is never name-identical to a real, manually-
# managed device sharing that older prefix). Never applied to a point-to-
# point link's peer, which is expected to already be a real, separately-
# managed device. Off by default since it creates brand-new inventory records,
# not just links between existing ones.
ASSUME_CLIENT_DEVICES=False

# Cable a router's own interface to whatever's on the other end of a live,
# Full-state OSPF adjacency (routing/ospf/neighbor) - real routing-protocol
# evidence of a direct link, currently only implemented for RouterOS
# (drivers/routeros.py's get_ospf_neighbours()). Only acts when exactly one
# distinct neighbour router ID is seen on a given local interface (a shared/
# broadcast segment carrying more than one is left alone rather than
# guessed at), and only when the neighbour's reported address and its
# router ID (this fleet's convention: each router's own loopback address)
# both resolve to the same NetBox device - a mismatch is logged as a
# warning and skipped rather than trusted blindly. Off by default since,
# like the subnet-linking rules above, it's still an inference from
# indirect evidence, not a device directly reporting its own cabling.
ASSUME_OSPF_LINKS=False
